PORT=3377
HOST=http://localhost
ALLOWED_ORIGINS=http://localhost:3377
JSON_BODY_LIMIT=1mb
URL_ENCODED_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
NODE_ENV=test
# Number of reverse proxy hops to trust (e.g. 2 for Cloudflare + Railway)
TRUST_PROXY_HOPS=2
MONGO_CONNECTION=mongodb
MONGO_URL=localhost:27017
MONGO_DB=test
MONGO_USERNAME=localUser
MONGO_PASSWORD=localPassword
MONGO_APP_NAME="Cluster0"
JWT_SECRET=secret
JWT_DEFAULT_DURATION=2h
BCRYPT_SALT_ROUNDS=12
MONGO_REPLICA_SET=rs0
# Frontend page that receives the activation link; the token travels only in the `#` fragment.
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GitHub OAuth app credentials. The redirect URI is registered with the GitHub
# app and used server-side for the code exchange; the client never sends it.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
# Prints application logs during tests (log files are never written in tests).
# TEST_LOGS=1
# Email (Resend). Test always records in memory. Development sends for real
# when RESEND_API_KEY is set and simulates (logs) when it is not. Production
# sends through Resend and refuses to start without key and sender. Any other
# NODE_ENV refuses to start.
# Free plan: 100 emails/day, 3,000/month, shared by every environment using the key.
# MAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
# MAIL_FROM_NAME=Agro
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_SEND_TIMEOUT_MS=5000
# Cache (all optional). Empty/unset REDIS_URL = in-memory-only mode: graceful
# degradation with no setup, used by tests and local development. Point REDIS_URL
# at a reachable Redis (e.g. redis://localhost:6379) to exercise the real backend.
# A missing or unreachable Redis never breaks requests — it falls back to memory.
REDIS_URL=
CACHE_ENABLED=true
CACHE_CATALOG_TTL_SECONDS=86400   # 24 h catalog freshness backstop
CACHE_BACKEND_TIMEOUT_MS=50       # 50 ms Redis call ceiling
CACHE_FALLBACK_TTL_SECONDS=30     # short-lived in-memory fallback
CACHE_FALLBACK_MAX_ENTRIES=1000   # bounded fallback (LRU eviction)
